#!/usr/bin/osascript -l JavaScript

// リマインダーアプリをインスタンス化
const app = Application('Reminders');
app.includeStandardAdditions = true;

const STOCK_LIST_NAME = "ItemStock";
const DEFAULT_LIST_NAME = "定期的な家事";

function parseBodyConfig(body, itemName) {
    if (body === null || body === undefined) {
        console.log(`[ERROR] ${itemName}: コメント(body)が空です。期待フォーマット: 日数[,登録先リマインダー名]`);
        return null;
    }

    const bodyText = String(body);
    const commaIndex = bodyText.indexOf(',');

    let daysText = bodyText;
    let listNameText = "";

    if (commaIndex >= 0) {
        daysText = bodyText.slice(0, commaIndex);
        listNameText = bodyText.slice(commaIndex + 1);
    }

    const days = parseInt(daysText.trim(), 10);
    if (Number.isNaN(days)) {
        console.log(`[ERROR] ${itemName}: 日数の解釈に失敗しました。body="${bodyText}" 期待フォーマット: 日数[,登録先リマインダー名]`);
        return null;
    }

    const targetListName = listNameText.trim();
    return {
        days,
        targetListName: targetListName.length > 0 ? targetListName : null
    };
}

function loadStockItems() {
    const stockList = app.lists.byName(STOCK_LIST_NAME);
    if (!stockList.exists()) {
        console.log(`リスト "${STOCK_LIST_NAME}" が見つかりません。`);
        return {};
    }
    // リスト内の全てのリマインダーを取得
    const stockItems = stockList.reminders.where({ completed: false});
    const names = stockItems.name();
    const bodies = stockItems.body();
    // 空の辞書を作成
    const stockDict = {};
    for (let i = 0; i < names.length; i++) {
        const parsed = parseBodyConfig(bodies[i], names[i]);
        if (!parsed) {
            console.log(`[SKIP] ${names[i]}: コメント(body)の形式が不正のためスキップします。`);
            continue;
        }
        stockDict[names[i]] = parsed;
    }
    return stockDict;
}

// 1. データの定義（辞書 / Object）
/*
const tasksToManage = {
    "台所の排水口の掃除": 23,
    "トイレ掃除": 3,
    "洗面台の排水口の掃除": 19,
    "風呂掃除": 14,
    "掃除機で掃除": 3
};
*/

function run() {
    console.log(`Start: ${new Date().toLocaleString()}`);

    const stockItems = loadStockItems();

    const requiredListNames = new Set();
    for (const itemConfig of Object.values(stockItems)) {
        requiredListNames.add(itemConfig.targetListName || DEFAULT_LIST_NAME);
    }

    const listCache = {};
    for (const listName of requiredListNames) {
        const list = app.lists.byName(listName);
        if (!list.exists()) {
            console.log(`[ERROR] リスト "${listName}" が見つかりません。`);
            listCache[listName] = null;
            continue;
        }
        listCache[listName] = list;
    }

    const now = new Date();

    // 2. 各項目のループ処理
    for (const [title, config] of Object.entries(stockItems)) {
        const resolvedListName = config.targetListName || DEFAULT_LIST_NAME;
        const targetList = listCache[resolvedListName];
        if (!targetList) {
            console.log(`[SKIP] ${title}: 登録先リスト "${resolvedListName}" が利用できないためスキップします。`);
            continue;
        }
        
        // 3. 既存の項目を検索（フィルタリング）
        // titleが一致し、かつ未完了のものを抽出
        const existingReminders = targetList.reminders.where({
            name: title,
            completed: false
        })();

        // 4. 存在しない場合のみ登録
        if (existingReminders.length === 0) {
            
            // 期限の計算（現在時刻 + N日）
            let dueDate = new Date(now.getTime());
            dueDate.setDate(dueDate.getDate() + config.days);

            // 5. 新規リマインダーのオブジェクト作成とプッシュ
            const newReminder = app.Reminder({
                name: title,
                dueDate: dueDate
            });
            
            targetList.reminders.push(newReminder);
            
            console.log(`Inserted: ${title} -> ${resolvedListName} (期限: ${dueDate.toLocaleString()})`);
        }
    }
}
